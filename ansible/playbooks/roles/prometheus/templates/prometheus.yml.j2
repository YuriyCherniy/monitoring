global:
  scrape_interval: 15s

  external_labels:
    monitor: 'prometheues_external_labels'

scrape_configs:
  - job_name: 'prometheus'
    scrape_interval: 15s
    static_configs:
      - targets: ["{{ hostvars['monitoring_server']['ansible_host'] }}:9090"]

  - job_name: 'node_exporter'
    scrape_interval: 15s
    static_configs:
      - targets: ["{{ hostvars['monitoring_server']['ansible_host'] }}:9100"]

  - job_name: 'node_exporter_external'
    scrape_interval: 15s
    static_configs:
      - targets: ["{{ hostvars['app_server']['ansible_host'] }}:9100"]
