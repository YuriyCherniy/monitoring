global:
  scrape_interval: 15s

  external_labels:
    monitor: "prometheus_external_labels"

scrape_configs:
  - job_name: "prometheus"
    scrape_interval: 15s
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: "node_exporter"
    scrape_interval: 15s
    static_configs:

      - targets: ["{{ hostvars['monitoring_server']['ansible_private_ip'] }}:9100"]
        labels:
          role: "monitoring"

      - targets: ["{{ hostvars['app_server']['ansible_private_ip'] }}:9100"]
        labels:
          role: "application"
