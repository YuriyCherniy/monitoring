global:
  scrape_interval: 15s

  external_labels:
    monitor: "prometheus_external_labels"

scrape_configs:
  - job_name: "prometheus"
    scrape_interval: 15s
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: "node_exporter_monitoring"
    scrape_interval: 15s
    static_configs:
      - targets: ["host.docker.internal:9100"]

  - job_name: "node_exporter_application"
    scrape_interval: 15s
    static_configs:
      - targets: ["{{ hostvars['app_server']['ansible_host'] }}:9100"]
    basic_auth:
      username: "{{ node_exporter_admin_user }}"
      password: "{{ node_exporter_admin_password }}"
